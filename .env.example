# Copy to .env and fill in. docker-compose reads this file automatically.

# Signs session cookies. Generate one with:
#   openssl rand -hex 32
OWO_SESSION_SECRET=change-me-to-32-random-bytes

# What players type into the Minecraft client. Whatever resolves to this box
# from where your friends are: a LAN IP, a DDNS name, a Tailscale hostname.
OWO_PUBLIC_HOSTNAME=localhost

# Let anyone who can reach the UI create an account. Turn off once your
# friends have signed up.
OWO_ALLOW_REGISTRATION=true

# Optional: seed the first admin account on a fresh database.
# OWO_ADMIN_USERNAME=admin
# OWO_ADMIN_PASSWORD=

# Required only for CurseForge modpacks. Modrinth needs no key.
# Get one at https://console.curseforge.com/
OWO_CURSEFORGE_API_KEY=
